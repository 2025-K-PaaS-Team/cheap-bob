# PostgreSQL — payment 전용 DB
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# 암호화 — backend 와 동일 JWT_SECRET 공유 필수 (양쪽 다 쿠키를 검증해야 함)
JWT_SECRET=
JWT_ALGORITHM=

# Environment
ENVIRONMENT=
FRONTEND_URL=
FRONTEND_LOCAL_URL=
DEBUG=

# 낙관적 락 재시도
MAX_RETRY_LOCK=

# Internal MSA — 서비스 간 호출 인증/주소
# 양쪽 서비스가 같은 INTERNAL_SERVICE_TOKEN 을 공유 (env 로 주입). 헤더 검증으로 인가.
INTERNAL_SERVICE_TOKEN=
# 본 payment-svc 가 backend 의 /api/internal/* 를 호출할 base URL.
BACKEND_SERVICE_URL=

# 슈퍼 어드민 SMTP — 결제 확정 시 예약 이메일 발송용
SUPER_ADMIN_SMTP_USER=
SUPER_ADMIN_SMTP_PASSWORD=
SUPER_ADMIN_SMTP_EMAIL=
SUPER_ADMIN_SMTP_HOST=
SUPER_ADMIN_SMTP_PORT=
SUPER_ADMIN_SMTP_NAME=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_PATH=
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=gz
