# PostgreSQL — payment 전용 DB
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# 암호화 — main-backend 와 동일 JWT_SECRET 공유 필수 (양쪽 다 쿠키를 검증해야 함)
JWT_SECRET=
JWT_ALGORITHM=

# Environment
ENVIRONMENT=
FRONTEND_URL=
FRONTEND_LOCAL_URL=
DEBUG=

# 낙관적 락 재시도
MAX_RETRY_LOCK=

# Internal MSA — 서비스 간 호출 인증/주소
# 양쪽 서비스가 같은 INTERNAL_SERVICE_TOKEN 을 공유 (env 로 주입). 헤더 검증으로 인가.
INTERNAL_SERVICE_TOKEN=
# 본 payment-backend 가 main-backend 의 /api/internal/* 를 호출할 base URL.
BACKEND_SERVICE_URL=

# Kafka — Outbox 발행 + 이벤트 소비
# dev (docker-compose): kafka:9092 / 호스트 접속: localhost:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=cheapbob-payment-backend
KAFKA_CONSUMER_GROUP=payment-backend-consumer

# Outbox Relay — DB 의 outbox 테이블을 폴링해 Kafka 로 발행
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_POLL_INTERVAL_MS=200
OUTBOX_RELAY_IDLE_BACKOFF_MS=1000

# Resilience — Circuit Breaker / Retry. internal_client / PortOne 호출에 적용.
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_SEC=10
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200

# 슈퍼 어드민 SMTP — 결제 확정 시 예약 이메일 발송용
SUPER_ADMIN_SMTP_USER=
SUPER_ADMIN_SMTP_PASSWORD=
SUPER_ADMIN_SMTP_EMAIL=
SUPER_ADMIN_SMTP_HOST=
SUPER_ADMIN_SMTP_PORT=
SUPER_ADMIN_SMTP_NAME=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_PATH=
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=gz
